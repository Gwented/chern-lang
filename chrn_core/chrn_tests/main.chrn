// Should be able to use overrides from other modules
override->

JAVA {
    types {
        i8 = self::byte
        i16, i32 = java::int
        i32 = long
    }
}

CPP {
    // Ok but what if I want a SPECIFIC u64 to be an unsinged long long but I want the others, or
