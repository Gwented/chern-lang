// let unused = 3

// Are duplicate params errors?

// Parameter type constraint not inferred
// Same name alias and local variable should maybe not be an error?

// Aliases themselves do have type constraints actually
// Ranged probably can't really work here because, if a string can be ranged along with 
// a number, then those can't be lowered to anything with confidence really.

// alias default() = []
// alias frosted(used) = [IsEmpty, Contains(used)]

// How shoulud aliasses infer their own constraints?

// In this scenario, it should see that equals x is used, meaning it's numeric.
// It sees y is startsW, filters, Numeric is all that's left since that's all they have in common.
// IsEmpty is entirely only usable for CharacterMappable, so it would just error.
alias default(x: Numeric, y: Ranged) = [Equals(x), StartsW(y), IsEmpty]

var->
    // Conds need shallow checks too so should err if struct or enum is used
    // again suggesting that it needs to be applied to the struct directly

    // Does not error if an argument using a type different from the current type is used
nest->
    // Arguments correctly error upon being given a self referential type that depends on itself
    // satisfying something like IsEmpty.
    struct Doof {
        a: i32 [Range(0, 9)]
        b: i32
    } [Range(0, 8)]

    struct Thingy {
        name: unsized
        age: str
    } []
@end
