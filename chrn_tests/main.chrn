// Add namespace handling for ~str to be a valid type with "str" as the name
// Add negatives

@def

// alias default(x) = [IsEmpty] #warn

var->
    s: str /*[default()]*/
    a: ~str
nest->
    // Circular ref possible because str has no behavior internally as a type
    //  What if struct ~str and str inside

    struct str {
        name: str
    } #bin

    struct str {
        name: str
    } #bin

@end

