@def

@
 
@def

// Some form of node cache?
var->
    program_id: u32
    metadata: Metadata
nest->
    struct Metadata {
        path: str
        src_bytes: List<u8>
        new_lines: List<unsized>
        lex_start: unsized
        serial_start: unsized
        can_color: bool
    } #ignore

    enum State {
        Ready(str),
    }
@end

@def
// alias default(x) = [IsEmpty, Range(x,7)]

var->
    // Make conditions actually enforce themselves
    a: A [Equals(READ)]

    // s: ~str [default()]
nest->
    struct A {
        // Fix this
        thing: A
        thing: B
    }


    struct B {}

@end

// Easiest possible way to use the language if no features are needed
@def
SIMPLE_MODE

var->
    // Most sane way to make cross language choices
    path: ?
    src_bytes: ?
    new_lines: ?
    lex_start: ?
    serial_start: ?
    can_color: ?
@end

tuple C(i32, i32)

